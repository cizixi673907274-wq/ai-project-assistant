{
  "name": "ai-field-assistant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:admin": "pnpm --filter @ai-field/admin-web dev",
    "dev:miniapp": "pnpm --filter @ai-field/miniapp dev:weapp",
    "miniapp:preview": "python3 scripts/prepare_miniapp_preview.py",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
