APP_ENV=development
APP_NAME=AI项目助手
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://ai_field:ai_field@postgres:5432/ai_field
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-field-media
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
AI_PROVIDER=mock
ASR_PROVIDER=mock
AI_REVIEW_THRESHOLD=0.85
AI_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=chat_completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
ASR_MODEL=whisper-1
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
AI_PROMPT_VERSION=phase3-v1
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
WECHAT_MOCK=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
TARO_APP_SUBSCRIBE_TEMPLATE_IDS=
ALLOW_MOCK_IN_PRODUCTION=false
MAX_UPLOAD_MB=20
EXPORT_STORAGE=local
EXPORT_DIR=./generated_exports
MAX_EXPORT_RECORDS=5000
TASK_QUEUE_MODE=inline
TASK_QUEUE_NAME=ai-project:exports
TASK_WORKER_HEARTBEAT_KEY=ai-project:worker:heartbeat
EXPORT_JOB_MAX_ATTEMPTS=3
EXPORT_RETENTION_DAYS=7
EXPORT_CLEANUP_INTERVAL_SECONDS=3600
EXPORT_STALE_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:10086,http://127.0.0.1:10086
VITE_API_BASE_URL=http://localhost:8000/api/v1
TARO_APP_API_BASE_URL=http://localhost:8000/api/v1
