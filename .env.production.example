APP_ENV=production
APP_NAME=AI项目助手
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-postgres-password
REDIS_PASSWORD=replace-redis-password
MINIO_ACCESS_KEY=replace-minio-access-key
MINIO_SECRET_KEY=replace-minio-secret-key
MINIO_BUCKET=ai-project-media
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=files.example.com
MINIO_PUBLIC_SECURE=true
AI_PROVIDER=openai_compatible
ASR_PROVIDER=tencent_cloud
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_STYLE=responses
AI_API_KEY=replace-ai-api-key
AI_MODEL=replace-volcengine-ark-endpoint-id
ASR_MODEL=whisper-1
AI_MAX_RETRIES=1
WECHAT_MOCK=false
WECHAT_APP_ID=replace-wechat-app-id
WECHAT_APP_SECRET=replace-wechat-app-secret
ALLOW_MOCK_IN_PRODUCTION=false
EXPORT_STORAGE=minio
MAX_EXPORT_RECORDS=5000
TASK_QUEUE_MODE=redis
TASK_QUEUE_NAME=ai-project:exports
TASK_WORKER_HEARTBEAT_KEY=ai-project:worker:heartbeat
EXPORT_JOB_MAX_ATTEMPTS=3
EXPORT_RETENTION_DAYS=7
EXPORT_CLEANUP_INTERVAL_SECONDS=3600
EXPORT_STALE_MINUTES=15
CORS_ORIGINS=https://assistant.example.com

# Production SMS sending is not implemented; use WeChat login.
SMS_MOCK=false
OCR_PROVIDER=mock
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_APP_ID=
